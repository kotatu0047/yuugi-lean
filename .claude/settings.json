{
  "permissions": {
    "deny": [
      "Edit(/spec/**)",
      "Write(/spec/**)",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Write(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Write(/.claude/hooks/**)",
      "Edit(/.github/workflows/**)",
      "Write(/.github/workflows/**)",
      "Edit(/.githooks/**)",
      "Write(/.githooks/**)",
      "Edit(/tools/check-all.sh)",
      "Write(/tools/check-all.sh)",
      "Edit(/jobs/accept.py)",
      "Write(/jobs/accept.py)",
      "Edit(/lakefile.toml)",
      "Write(/lakefile.toml)",
      "Edit(/lean-toolchain)",
      "Write(/lean-toolchain)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR\"/spec/guard.py" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/spec/stop-gate.sh", "timeout": 900 }
        ]
      }
    ]
  }
}
