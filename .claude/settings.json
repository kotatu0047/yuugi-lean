{
  "permissions": {
    "deny": [
      "Edit(/spec/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.github/workflows/**)",
      "Edit(/.githooks/**)",
      "Edit(/tools/check-all.sh)",
      "Edit(/jobs/accept.py)",
      "Edit(/lakefile.toml)",
      "Edit(/lean-toolchain)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/spec/guard.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/spec/stop-gate.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
