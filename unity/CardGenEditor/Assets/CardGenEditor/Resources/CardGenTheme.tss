@import url("unity-theme://default");

/* SF 映画の画面のような HUD 風の見た目。色は Theme.cs と揃える
   （シアン rgb(0,229,255)・アンバー rgb(255,184,0)・本文 rgb(200,236,255)） */

/* ボタン：透ける暗い地に、細いシアンの線。角はほぼ四角 */
.unity-button {
    background-color: rgba(0, 229, 255, 0.05);
    color: rgb(214, 240, 255);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.32);
    border-radius: 2px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-center;
}
.unity-button:hover {
    background-color: rgba(0, 229, 255, 0.14);
    border-color: rgba(0, 229, 255, 0.85);
    color: rgb(235, 250, 255);
}
.unity-button:active {
    background-color: rgba(0, 229, 255, 0.32);
    border-color: rgb(0, 229, 255);
    color: rgb(255, 255, 255);
}
.unity-button:disabled {
    background-color: rgba(0, 229, 255, 0.02);
    border-color: rgba(156, 190, 210, 0.3);
    color: rgba(156, 190, 210, 0.75);
}

/* 入力欄：ほぼ黒の地に細い線。選んでいるときはシアン */
.unity-base-text-field__input,
.unity-base-field__input,
.unity-base-popup-field__input {
    background-color: rgba(0, 0, 0, 0.45);
    color: rgb(214, 240, 255);
    border-width: 1px;
    border-color: rgba(0, 229, 255, 0.22);
    border-radius: 2px;
}
.unity-base-text-field:focus .unity-base-text-field__input,
.unity-base-field:focus .unity-base-field__input,
.unity-base-text-field:focus:enabled > .unity-base-text-field__input,
.unity-base-field:focus:enabled > .unity-base-field__input {
    border-color: rgba(0, 229, 255, 0.9);
}
.unity-base-field__label {
    color: rgb(156, 190, 210);
}
/* 選んでいる欄（ラベルをクリックしたときも）のラベルは、標準の暗い青ではなく明るいシアン。マウスを乗せたら白っぽく */
.unity-base-field:hover > .unity-base-field__label,
.unity-base-field:hover:enabled > .unity-base-field__label {
    color: rgb(235, 250, 255);
}
.unity-base-field:focus > .unity-base-field__label,
.unity-base-field:focus:enabled > .unity-base-field__label,
.unity-base-field:focus:hover:enabled > .unity-base-field__label,
.unity-base-field:checked:enabled > .unity-base-field__label,
.unity-base-field:active:enabled > .unity-base-field__label {
    color: rgb(0, 229, 255);
}
.unity-text-element--inner-input-field-component {
    color: rgb(214, 240, 255);
}
.unity-toggle__checkmark {
    background-color: rgba(0, 0, 0, 0.45);
    border-color: rgba(0, 229, 255, 0.45);
    border-radius: 1px;
    -unity-background-image-tint-color: rgb(0, 229, 255);
}
.unity-popup-field__arrow,
.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(0, 229, 255);
}

/* 選ぶ形の入力（セレクトボックス）：ほかの入力欄より少し明るい地と濃い線で、押せることが分かるように。
   マウスを乗せる・押す・一覧を開いているときも暗い地のまま（標準の灰色にしない） */
.unity-base-popup-field__input {
    background-color: rgba(0, 229, 255, 0.07);
    border-color: rgba(0, 229, 255, 0.45);
}
.unity-base-popup-field__input:hover,
.unity-base-popup-field:hover .unity-base-popup-field__input,
.unity-base-popup-field:hover:enabled > .unity-base-popup-field__input,
.unity-base-field:hover:enabled > .unity-base-popup-field__input,
.unity-base-popup-field__input:hover:enabled {
    background-color: rgba(0, 229, 255, 0.14);
    border-color: rgba(0, 229, 255, 0.85);
}
.unity-base-popup-field__input:active,
.unity-base-popup-field__input:checked,
.unity-base-popup-field__input:hover:checked,
.unity-base-popup-field__input:focus,
.unity-base-popup-field:focus .unity-base-popup-field__input,
.unity-base-popup-field:checked > .unity-base-popup-field__input,
.unity-base-popup-field:active > .unity-base-popup-field__input,
.unity-base-popup-field:hover:checked > .unity-base-popup-field__input,
.unity-base-popup-field:hover:active > .unity-base-popup-field__input,
.unity-base-field:focus:enabled > .unity-base-popup-field__input,
.unity-base-field:checked:enabled > .unity-base-popup-field__input,
.unity-base-field:active:enabled > .unity-base-popup-field__input,
.unity-base-popup-field__input:active:enabled,
.unity-base-popup-field__input:checked:enabled,
.unity-base-popup-field__input:hover:active:enabled,
.unity-base-popup-field__input:hover:checked:enabled {
    background-color: rgba(0, 229, 255, 0.2);
    border-color: rgb(0, 229, 255);
}
.unity-base-popup-field__text {
    color: rgb(235, 250, 255);
}

/* 選ぶ形の入力の一覧：暗い地に明るい文字。選んでいる項目はシアンの帯、マウスを乗せた項目はアンバーの帯 */
.unity-base-dropdown__container-outer {
    background-color: rgb(8, 19, 29);
    border-color: rgba(0, 229, 255, 0.7);
    border-width: 1px;
}
.unity-base-dropdown__container-inner {
    background-color: rgb(8, 19, 29);
    border-width: 0;
}
.unity-base-dropdown__item {
    background-color: rgba(0, 0, 0, 0);
    min-height: 26px;
}
.unity-base-dropdown__item:checked {
    background-color: rgba(0, 229, 255, 0.22);
}
.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:hover:checked,
.unity-base-dropdown__item:focus {
    background-color: rgba(255, 184, 0, 0.22);
}
.unity-base-dropdown__label,
.unity-base-dropdown__item:checked .unity-base-dropdown__label,
.unity-base-dropdown__item:hover .unity-base-dropdown__label {
    color: rgb(235, 250, 255);
    font-size: 13px;
}
.unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: rgb(0, 229, 255);
}
.unity-base-dropdown__separator {
    background-color: rgba(0, 229, 255, 0.25);
}

/* スクロールバー：細く、矢印なし、溝はうっすら、つまみは半透明のシアン（マウスを乗せると明るく、つかむとアンバー） */
.unity-scroller--vertical {
    width: 8px;
    min-width: 8px;
    margin-left: 2px;
    margin-right: 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller--horizontal {
    height: 8px;
    min-height: 8px;
    margin-top: 2px;
    margin-bottom: 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}
.unity-scroller .unity-base-slider__input {
    margin: 0;
}
.unity-scroller--vertical > .unity-scroller__slider {
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 0;
    margin-right: 0;
    width: 8px;
    min-width: 8px;
    flex-grow: 1;
}
.unity-scroller--horizontal > .unity-scroller__slider {
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    height: 8px;
    min-height: 8px;
    flex-grow: 1;
}
.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 229, 255, 0.05);
    border-width: 0;
    border-radius: 4px;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
}
.unity-scroller .unity-base-slider__dragger {
    background-color: rgba(0, 229, 255, 0.28);
    border-width: 0;
    border-radius: 4px;
    margin: 0;
}
.unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
    left: 0;
}
.unity-scroller--horizontal .unity-base-slider__dragger {
    height: 8px;
    top: 0;
}
.unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(0, 229, 255, 0.55);
}
.unity-scroller .unity-base-slider__dragger:active {
    background-color: rgba(255, 184, 0, 0.8);
}
.unity-scroller .unity-base-slider__dragger-border {
    display: none;
}
