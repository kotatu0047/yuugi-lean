@import url("unity-theme://default");

/* 暗い背景に合わせて、入力欄とボタンも暗い色にする */
.unity-button {
    background-color: rgb(58, 58, 64);
    color: rgb(235, 235, 240);
    border-color: rgb(85, 85, 92);
}
.unity-button:hover {
    background-color: rgb(74, 74, 82);
}
.unity-button:active {
    background-color: rgb(95, 95, 105);
}
.unity-base-text-field__input,
.unity-base-field__input,
.unity-base-popup-field__input {
    background-color: rgb(36, 36, 40);
    color: rgb(235, 235, 240);
    border-color: rgb(80, 80, 88);
}
.unity-base-field__label {
    color: rgb(200, 200, 208);
}
.unity-toggle__checkmark {
    background-color: rgb(36, 36, 40);
    border-color: rgb(110, 110, 120);
}

/* スクロールバー：細く、矢印なし、溝は透明、つまみは角の丸い半透明（マウスを乗せると明るく） */
.unity-scroller--vertical {
    width: 8px;
    min-width: 8px;
    margin-left: 2px;
    margin-right: 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller--horizontal {
    height: 8px;
    min-height: 8px;
    margin-top: 2px;
    margin-bottom: 2px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}
.unity-scroller .unity-base-slider__input {
    margin: 0;
}
.unity-scroller--vertical > .unity-scroller__slider {
    margin-top: 2px;
    margin-bottom: 2px;
    margin-left: 0;
    margin-right: 0;
    width: 8px;
    min-width: 8px;
    flex-grow: 1;
}
.unity-scroller--horizontal > .unity-scroller__slider {
    margin-left: 2px;
    margin-right: 2px;
    margin-top: 0;
    margin-bottom: 0;
    height: 8px;
    min-height: 8px;
    flex-grow: 1;
}
.unity-scroller .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 4px;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    margin: 0;
}
.unity-scroller .unity-base-slider__dragger {
    background-color: rgba(200, 200, 215, 0.28);
    border-width: 0;
    border-radius: 4px;
    margin: 0;
}
.unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
    left: 0;
}
.unity-scroller--horizontal .unity-base-slider__dragger {
    height: 8px;
    top: 0;
}
.unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(220, 220, 235, 0.5);
}
.unity-scroller .unity-base-slider__dragger:active {
    background-color: rgba(240, 200, 90, 0.7);
}
.unity-scroller .unity-base-slider__dragger-border {
    display: none;
}
